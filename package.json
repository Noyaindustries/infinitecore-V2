{
  "name": "infinitecore",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env TURBOPACK=1 PORT=3000 tsx scripts/devUnified.ts",
    "build": "next build && npm run build:api && npm run build:start",
    "build:start": "esbuild scripts/startUnified.ts --bundle --platform=node --target=node20 --packages=external --outfile=dist/startUnified.cjs --format=cjs",
    "build:api": "esbuild server.ts --bundle --platform=node --target=node18 --packages=external --outfile=dist/server.cjs --format=cjs",
    "build:next": "next build",
    "build:vercel": "next build",
    "start": "cross-env NODE_ENV=production node dist/startUnified.cjs",
    "start:api": "cross-env START_LISTEN=1 node dist/server.cjs",
    "verify:deploy": "node scripts/verifyDeploy.mjs",
    "generate:nextauth-secret": "node scripts/generateNextAuthSecret.mjs",
    "validate:nextauth-secret": "node --env-file=.env --env-file=.env.local scripts/generateNextAuthSecret.mjs --validate",
    "validate:secrets": "node --env-file=.env --env-file=.env.local scripts/validateSecrets.mjs",
    "validate:env": "tsx --env-file=.env --env-file=.env.local scripts/validateEnv.ts",
    "verify:git-env": "node scripts/verifyGitEnvHistory.mjs",
    "test:padde-webhook": "node scripts/testPaddeWebhook.mjs",
    "test:noya-recrutement-webhook": "node --env-file=.env.local scripts/testNoyaRecrutementWebhook.mjs",
    "diagnose:padde": "node scripts/diagnosePadde.mjs",
    "generate:app-covers": "node scripts/generateAppCoverSvgs.mjs",
    "lint": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:rbac && npm run test:data-query && npm run test:padde-admin-list",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:security": "vitest run tests/security && npm run test:e2e -- tests/e2e/api-security.spec.ts tests/e2e/auth-bypass-security.spec.ts",
    "test:security:audit": "npm audit --audit-level=high && npm run verify:git-env",
    "audit:fix": "npm audit fix",
    "test:licenses": "npm run test:unit -- tests/unit/licenses.vitest.ts",
    "test:stripe-checkout": "node --env-file=.env.local scripts/testStripeCheckout.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:rbac": "tsx tests/rbac.test.ts",
    "test:data-query": "tsx tests/dataQuery.test.ts",
    "test:padde-admin-list": "tsx tests/paddeCiAdminList.integration.test.ts",
    "migrate:users": "tsx scripts/migrateUsersToUserAccounts.ts",
    "migrate:split-data": "tsx scripts/migrateDataDocumentsToSplitCollections.ts",
    "backfill:referrals": "tsx scripts/backfillReferralPartnerIds.ts",
    "backfill:user-profiles": "tsx scripts/backfillUserProfileFields.ts",
    "backfill:partner-commissions": "tsx scripts/backfillPartnerCommissions.ts",
    "seed:test-data": "tsx scripts/seedTestData.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/s3-request-presigner": "^3.1068.0",
    "@google/genai": "^0.15.0",
    "@prisma/client": "^6.19.3",
    "@types/multer": "^2.1.0",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.2",
    "busboy": "^1.6.0",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "framer-motion": "^12.40.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.577.0",
    "mongodb": "^7.3.0",
    "multer": "^2.1.1",
    "next": "^15.2.4",
    "nodemailer": "^8.0.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.13.1",
    "serverless-http": "^4.0.0",
    "stripe": "^22.2.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@netlify/functions": "^5.1.5",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.4",
    "cross-env": "^7.0.3",
    "esbuild": "^0.27.4",
    "postcss": "^8.5.15",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "postcss": "^8.5.15",
    "uuid": "^11.1.1"
  }
}
